# Copy to .env and fill in paper keys from Alpaca dashboard.
# Never commit .env

ALPACA_API_KEY=your_paper_key_id
ALPACA_SECRET_KEY=your_paper_secret_key
ALPACA_PAPER=true
# Host only — do NOT append /v2 (client adds /v2/account etc.)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data (same keys; host only — no /v2)
ALPACA_DATA_URL=https://data.alpaca.markets
# Free/paper default is iex; sip requires paid plan
ALPACA_DATA_FEED=iex

# Local LLM (Ollama) — agents never call cloud models
OLLAMA_HOST=http://127.0.0.1:11434
NEOTRADE_OLLAMA_MODEL=llama3.2:3b
# NEOTRADE_OLLAMA_TEMP=0.2
# NEOTRADE_OLLAMA_TIMEOUT=120

# Quote monitor (watch only — never executes)
# NEOTRADE_MONITOR_INTERVAL=15
# NEOTRADE_MONITOR_MOVE_PCT=1.0
# NEOTRADE_MONITOR_LOG=data/learning/monitor.jsonl
